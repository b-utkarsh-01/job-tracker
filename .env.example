# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/job_tracker?retryWrites=true&w=majority
#
# Username & Password: MongoDB Atlas → Database Access → Create User
# Cluster: MongoDB Atlas → Database → Connect → Connect your application → Copy string
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/job_tracker?retryWrites=true&w=majority

# Server Port (default: 3000)
PORT=3000
